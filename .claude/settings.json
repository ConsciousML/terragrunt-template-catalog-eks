{
  "permissions": {
    "defaultMode": "default",
    "additionalDirectories": [
      "../argocd-app-of-apps-template",
      "/tmp"
    ],
    "allow": [
      "Bash(kubectl:*)",
      "Bash(terragrunt plan*)",
      "Bash(terragrunt validate*)",
      "Bash(terragrunt output*)",
      "Bash(terragrunt render*)",
      "Bash(terragrunt hclfmt*)",
      "Bash(terragrunt info*)",
      "Bash(terragrunt graph*)",
      "Bash(tofu plan*)",
      "Bash(tofu validate*)",
      "Bash(tofu output*)",
      "Bash(tofu fmt*)",
      "Bash(tofu graph*)",
      "Bash(tflint:*)",
      "Bash(trivy:*)",

      "Bash(aws * describe-*)",
      "Bash(aws * get-*)",
      "Bash(aws * list-*)",
      "Bash(aws * head-*)",
      "Bash(aws sts get-caller-identity)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",

      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",

      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(column:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",

      "Bash(hubble observe:*)"
    ],
    "ask": [
      "Bash(terragrunt apply*)",
      "Bash(terragrunt destroy*)",
      "Bash(terragrunt run --all apply*)",
      "Bash(terragrunt run --all destroy*)",
      "Bash(terragrunt run-all apply*)",
      "Bash(terragrunt run-all destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(aws *)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(.env)",

      "Read(.git/**)",
      "Edit(.git/**)",

      "Read(../argocd-app-of-apps-template/.git/**)",
      "Edit(../argocd-app-of-apps-template/.git/**)",

      "Edit(.claude/**)",

      "Edit(../argocd-app-of-apps-template/.claude/**)"
    ]
  }
}
